             RowBox[{"NumberForm", "[", 
              RowBox[{
               RowBox[{"#1", "[", "\"\<empiricalCorrelation\>\"", "]"}], ",", 
               RowBox[{"{", 
                RowBox[{"7", ",", "4"}], "}"}]}], "]"}]}], "}"}], "&"}], ",", 
          "ranking"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"Print", "[", 
        RowBox[{"Grid", "[", 
         RowBox[{
