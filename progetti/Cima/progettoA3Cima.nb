              ",", "\"\<|Bias|\>\"", ",", "\"\<Correlazione empirica\>\""}], 
             "}"}]}], "]"}], ",", 
          RowBox[{"Frame", "->", "All"}], ",", 
          RowBox[{"Alignment", "->", "Center"}]}], "]"}], "]"}]}]}], "]"}]}], 
   ";"}], "\[IndentingNewLine]", "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"trueEffectiveFinalNibble", "[", 
     RowBox[{"key_Integer", ",", "rounds_Integer", ",", "position_Integer", ",", 
      RowBox[{"keysize_Integer", ":", "80"}]}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", "lastKey", "}"}], ",", 
      RowBox[{
       RowBox[{"lastKey", "=", 
        RowBox[{"Last", "[", 
         RowBox[{"genRoundKeys", "[", 
          RowBox[{"key", ",", "rounds", ",", "keysize"}], "]"}], "]"}]}], ";",
        "\[IndentingNewLine]", 
       RowBox[{"getNibble", "[", 
        RowBox[{
         RowBox[{"pLayerInv", "[", "lastKey", "]"}], ",", "position"}], 
        "]"}]}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{"ESPERIMENTO", " ", "COMPLETO", " ", "DI", " ", "RANKING"}], 
   "*)"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"runReducedKeyRankingExperiment", "[", 
     RowBox[{
      RowBox[{"attackRounds_Integer", ":", "5"}], ",", 
      RowBox[{"pairCount_Integer", ":", "20000"}], ",", 
      RowBox[{"key_Integer", ":", "0"}], ",", 
      RowBox[{"keysize_Integer", ":", "80"}], ",", 
      RowBox[{"beamWidth_Integer", ":", "200"}], ",", 
      RowBox[{"localLimit_Integer", ":", "48"}], ",", 
      RowBox[{"inputBits_List", ":", 
       RowBox[{"Range", "[", 
        RowBox[{"0", ",", "15"}], "]"}]}]}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "trails", ",", "trail", ",", "info", ",", "pairs", ",", "ranking", ",",
         "trueGuess", ",", "truePosition", ",", "trueRank"}], "}"}], ",", 
      RowBox[{
       RowBox[{"Print", "[", 
        RowBox[{"\"\<Ricerca di un trail d'attacco su \>\"", ",", 
         RowBox[{"attackRounds", "-", "1"}], ",", "\"\< round...\>\""}], 
        "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"trails", "=", 
        RowBox[{"findAttackTrails", "[", 
         RowBox[{
          RowBox[{"attackRounds", "-", "1"}], ",", "10", ",", "beamWidth", ",",
           "localLimit", ",", "inputBits"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"trails", "===", 
          RowBox[{"{", "}"}]}], ",", 
         RowBox[{
          RowBox[{
          "Print", 
           "[", "\"\<Nessun trail con una sola S-box finale trovato. \>\"", 
           "]"}], ";", "\[IndentingNewLine]", 
          RowBox[{"Return", "[", "$Failed", "]"}]}]}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"trail", "=", 
        RowBox[{"First", "[", "trails", "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"info", "=", 
        RowBox[{"singleActiveNibbleInfo", "[", 
         RowBox[{"trail", "[", "\"\<mask\>\"", "]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"truePosition", "=", 
        RowBox[{"info", "[", "\"\<position\>\"", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Print", "[", "\"\<Trail scelto:\>\"", "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Print", "[", 
        RowBox[{"\"\<  maschera iniziale = \>\"", ",", 
         RowBox[{"hex64", "[", 
          RowBox[{"trail", "[", "\"\<input\>\"", "]"}], "]"}]}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Print", "[", 
        RowBox[{"\"\<  maschera prima dell'ultima S-box = \>\"", ",", 
         RowBox[{"hex64", "[", 
          RowBox[{"trail", "[", "\"\<mask\>\"", "]"}], "]"}]}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Print", "[", 
        RowBox[{"\"\<  peso = \>\"", ",", 
         RowBox[{"trail", "[", "\"\<weight\>\"", "]"}]}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Print", "[", 
        RowBox[{"\"\<  correlazione teorica = \>\"", ",", 
         RowBox[{"trail", "[", "\"\<correlation\>\"", "]"}]}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Print", "[", 
        RowBox[{"\"\<  S-box attive complessive = \>\"", ",", 
         RowBox[{"trail", "[", "\"\<active\>\"", "]"}]}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Print", "[", 
        RowBox[{"\"\<Generazione di \>\"", ",", "pairCount", 
         ",", "\"\< coppie note...\>\""}], "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"pairs", "=", 
        RowBox[{"generateKnownPairs", "[", 
         RowBox[{
         "key", ",", "attackRounds", ",", "pairCount", ",", "keysize"}], 
         "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"ranking", "=", 
        RowBox[{"rankFinalSubkeyNibble", "[", 
         RowBox[{"pairs", ",", 
          RowBox[{"trail", "[", "\"\<input\>\"", "]"}], ",", 
          RowBox[{"trail", "[", "\"\<mask\>\"", "]"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"trueGuess", "=", 
        RowBox[{"trueEffectiveFinalNibble", "[", 
         RowBox[{
         "key", ",", "attackRounds", ",", "truePosition", ",", "keysize"}], 
         "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"trueRank", "=", 
        RowBox[{"First", "[", 
         RowBox[{"FirstPosition", "[", 
          RowBox[{"ranking", ",", 
           RowBox[{"association_", "/;", 
            RowBox[{
             RowBox[{"association", "[", "\"\<guess\>\"", "]"}], "==", 
             "trueGuess"}]}]}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"printSubkeyRanking", "[", "ranking", "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Print", "[", 
        RowBox[{"\"\<Nibble vero di pLayerInv[K_final] = \>\"", ",", 
         RowBox[{"ToUpperCase", "[", 
          RowBox[{"IntegerString", "[", 
           RowBox[{"trueGuess", ",", "16", ",", "1"}], "]"}], "]"}], 
         ",", "\"\<; posizione = \>\"", ",", "truePosition", 
         ",", "\"\<; rango ottenuto = \>\"", ",", "trueRank"}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<trail\>\"", "->", "trail"}], ",", 
         RowBox[{"\"\<ranking\>\"", "->", "ranking"}], ",", 
         RowBox[{"\"\<trueGuess\>\"", "->", "trueGuess"}], ",", 
         RowBox[{"\"\<trueRank\>\"", "->", "trueRank"}], ",", 
         RowBox[{"\"\<pairs\>\"", "->", "pairCount"}], ",", 
         RowBox[{"\"\<attackRounds\>\"", "->", "attackRounds"}]}], "|>"}]}]}],
      "]"}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"runChecks", "[", "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"checks", ",", "nonTrivialLAT"}], "}"}], ",", 
      RowBox[{
       RowBox[{
       "Print", "[", "\"\< \\nProva dei vettori ufficiali: \\n\>\"", "]"}], ";",
        "\[IndentingNewLine]", 
       RowBox[{"checks", "=", 
        RowBox[{"selfCheck", "[", "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"Print", "[", "checks", "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{
       "Print", 
        "[", "\"\< \\nCalcolo della LAT e dello spettro di Walsh:\\n \>\"", 
        "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"nonTrivialLAT", "=", 
        RowBox[{"Flatten", "[", "LAT", "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"nonTrivialLAT", "[", 
         RowBox[{"[", "1", "]"}], "]"}], "=", "0"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Print", "[", 
        RowBox[{"\"\<max |LAT| non banale = \>\"", ",", 
         RowBox[{"Max", "[", 
          RowBox[{"Abs", "[", "nonTrivialLAT", "]"}], "]"}]}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Print", "[", 
        RowBox[{"\"\<correlazione massima non banale = \>\"", ",", 
         RowBox[{
          RowBox[{"Max", "[", 
           RowBox[{"Abs", "[", "nonTrivialLAT", "]"}], "]"}], "/", "8"}]}], 
        "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"Print", "[", 
        RowBox[{"\"\<Walsh == 2 LAT? \>\"", ",", 
         RowBox[{"walshCheck", "[", "]"}]}], "]"}], ";", 
       "\[IndentingNewLine]", "checks"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]", "\n"}], "\[IndentingNewLine]", 
