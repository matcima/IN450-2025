      "dei", " ", "prodotti", " ", "a", "*", "x", " ", "e", " ", "b", "*", 
      "S", 
      RowBox[{"(", "x", ")"}]}]}], " ", "*)"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"LAT", " ", "=", " ", 
     RowBox[{"Table", "[", "\n", "   ", 
      RowBox[{
       RowBox[{
        RowBox[{"Sum", "[", 
         RowBox[{
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"parityBit", "[", 
              RowBox[{"BitAnd", "[", 
               RowBox[{"a", ",", " ", "x"}], "]"}], "]"}], " ", "==", " ", 
             RowBox[{"parityBit", "[", 
              RowBox[{"BitAnd", "[", 
               RowBox[{"b", ",", " ", 
                RowBox[{"sbox", "[", 
                 RowBox[{"[", 
                  RowBox[{"x", " ", "+", " ", "1"}], "]"}], "]"}]}], "]"}], 
              "]"}]}], ",", " ", "1", ",", " ", "0"}], "]"}], ",", "\n", 
          "       ", 
          RowBox[{"{", 
           RowBox[{"x", ",", " ", "0", ",", " ", "15"}], "}"}]}], "]"}], " ", 
        "-", " ", "8"}], ",", "\n", "   ", 
       RowBox[{"{", 
        RowBox[{"a", ",", " ", "0", ",", " ", "15"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"b", ",", " ", "0", ",", " ", "15"}], "}"}]}], "]"}]}], ";"}],
    "\n", "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
    "Matrice", " ", "di", " ", "Hadamard", " ", "di", " ", "Sylvester", " ", 
     "16", "x16", " ", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
       "equivalente", " ", "a", " ", "HadamardMatrix", " ", "a", " ", "meno", 
        "\n", "   ", "della", " ", "normalizzazione"}], ")"}], ".", " ", 
      RowBox[{"Verifichiamo", ":", " ", 
       RowBox[{
        RowBox[{"Walsh", 
         RowBox[{"(", " ", 
          RowBox[{"b", ".", "S"}], " ", ")"}]}], " ", "==", " ", 
        RowBox[{"2", "*", 
         RowBox[{"LAT", "[", 
          RowBox[{"[", 
           RowBox[{".", 
            RowBox[{",", "b"}]}], "]"}], "]"}]}]}]}]}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"walshH", "[", "n_", "]"}], " ", ":=", " ", 
     RowBox[{"Nest", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"ArrayFlatten", "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"#", ",", " ", "#"}], "}"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"#", ",", " ", 
             RowBox[{"-", "#"}]}], "}"}]}], "}"}], "]"}], " ", "&"}], ",", 
       " ", 
       RowBox[{"{", 
        RowBox[{"{", "1", "}"}], "}"}], ",", " ", "n"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"H16", " ", "=", " ", 
     RowBox[{"walshH", "[", "4", "]"}]}], ";"}], "\n", "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"walshSpectrum", "[", "b_", "]"}], " ", ":=", " ", 
     RowBox[{"H16", " ", ".", " ", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{"-", "1"}], ")"}], "^", 
         RowBox[{"parityBit", "[", 
          RowBox[{"BitAnd", "[", 
           RowBox[{"b", ",", " ", 
            RowBox[{"sbox", "[", 
             RowBox[{"[", 
              RowBox[{"x", " ", "+", " ", "1"}], "]"}], "]"}]}], "]"}], 
          "]"}]}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"x", ",", " ", "0", ",", " ", "15"}], "}"}]}], "]"}]}]}], 
    ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{"Controllo", " ", "di", " ", 
     RowBox[{"coerenza", ":", " ", 
      RowBox[{
       RowBox[{"walshSpectrum", "[", "b", "]"}], " ", "==", " ", 
       RowBox[{"2", "*", 
        RowBox[{"LAT", "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", " ", 
           RowBox[{"b", "+", "1"}]}], "]"}], "]"}], " ", "per", " ", "ogni", " ",
         "b"}]}]}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"walshCheck", "[", "]"}], " ", ":=", " ", 
     RowBox[{"AllTrue", "[", 
      RowBox[{
       RowBox[{"Range", "[", 
        RowBox[{"0", ",", " ", "15"}], "]"}], ",", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"walshSpectrum", "[", "#", "]"}], " ", "==", " ", 
         RowBox[{"2", " ", 
          RowBox[{"LAT", "[", 
           RowBox[{"[", 
            RowBox[{"All", ",", " ", 
             RowBox[{"#", " ", "+", " ", "1"}]}], "]"}], "]"}]}]}], " ", 
        "&"}]}], "]"}]}], ";"}], "\n", "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"Approssimazioni", " ", "single"}], "-", 
       RowBox[{"bit", " ", 
        RowBox[{"(", 
         RowBox[{
         "Hamming", " ", "weight", " ", "1", " ", "su", " ", "input", " ", 
          "e", " ", "output"}], ")"}]}]}], ":", "\n", "   ", "correlazione"}],
      " ", "=", " ", 
     RowBox[{
      RowBox[{"LAT", "/", "8"}], " ", "=", " ", 
      RowBox[{
       RowBox[{
        RowBox[{"+", 
         RowBox[{"-", "1"}]}], "/", "4"}], " ", "=", " ", 
       RowBox[{
        RowBox[{"+", 
         RowBox[{"-", 
          RowBox[{"2", "^", 
           RowBox[{"-", "2."}]}]}]}], "  ", "Il", " ", "bit", " ", "0", " ", 
        "non", " ", "compare", " ", 
        RowBox[{"mai", "."}]}]}]}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"nonZeroLAT", "[", 
      RowBox[{"{", 
       RowBox[{"inputMask_", ",", "outputMask_", ",", "latValue_"}], "}"}], 
      "]"}], ":=", 
     RowBox[{"latValue", "!=", "0"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"singleBitApprox", "[", "]"}], ":=", 
     RowBox[{"Select", "[", 
      RowBox[{
       RowBox[{"Flatten", "[", 
        RowBox[{
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"2", "^", "j"}], ",", 
             RowBox[{"2", "^", "k"}], ",", 
             RowBox[{"LAT", "[", 
              RowBox[{"[", 
               RowBox[{
                RowBox[{
                 RowBox[{"2", "^", "j"}], "+", "1"}], ",", 
                RowBox[{
                 RowBox[{"2", "^", "k"}], "+", "1"}]}], "]"}], "]"}]}], "}"}],
            ",", 
           RowBox[{"{", 
            RowBox[{"j", ",", "0", ",", "3"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"k", ",", "0", ",", "3"}], "}"}]}], "]"}], ",", "1"}], 
        "]"}], ",", "nonZeroLAT"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"DRIVER", ":", 
     RowBox[{
     "esegue", " ", "e", " ", "stampa", " ", "tutte", " ", "le", " ", 
      "verifiche", " ", "sperimentali"}]}], "*)"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"runAll", "[", "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", "}"}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
        "Print", "[", "\"\<\\n Prova dei vettori ufficiali: \\n\>\"", "]"}], ";",
         "\[IndentingNewLine]", 
        RowBox[{"testVectors", "[", "]"}], ";", "\n", "\[IndentingNewLine]", 
        RowBox[{
        "Print", 
         "[", "\"\<\\n Calcolo della LAT e dello spettro di WALSH: \\n\>\"", 
         "]"}], ";", "\n", "        ", 
        RowBox[{"Print", "[", 
         RowBox[{"\"\<max |LAT| non banale = \>\"", ",", " ", 
          RowBox[{"Max", "[", 
           RowBox[{"Abs", "[", 
            RowBox[{"Delete", "[", 
             RowBox[{
              RowBox[{"Flatten", "[", "LAT", "]"}], ",", " ", "1"}], "]"}], 
            "]"}], "]"}], ",", "\n", 
          "                      ", "\"\<  -> correlazione max = \>\"", ",", 
          " ", 
          RowBox[{
           RowBox[{"Max", "[", 
            RowBox[{"Abs", "[", 
             RowBox[{"Delete", "[", 
              RowBox[{
               RowBox[{"Flatten", "[", "LAT", "]"}], ",", " ", "1"}], "]"}], 
             "]"}], "]"}], "/", "8"}]}], "]"}], ";", "\n", 
        "\[IndentingNewLine]", "  ", 
        RowBox[{"wc", " ", "=", " ", 
         RowBox[{"walshCheck", "[", "]"}]}], ";", "\n", "         ", 
        RowBox[{"Print", "[", 
         RowBox[{"\"\<spettro di WALSH == 2*LAT per ogni maschera? \>\"", ",",
           " ", "wc"}], "]"}], ";", "\n", "         ", 
        RowBox[{"Print", "[", 
         RowBox[{"\"\<Approssimazioni single-bit {a,b,LAT}: \>\"", ",", " ", 
          RowBox[{"singleBitApprox", "[", "]"}]}], "]"}]}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"runAll", "[", "]"}], "\n"}]}]], "Input",
