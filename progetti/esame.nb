 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"trueEffectiveFinalNibble", "[", 
     RowBox[{"key_Integer", ",", "rounds_Integer", ",", "position_Integer", ",", 
      RowBox[{"keysize_Integer", ":", "80"}]}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", "lastKey", "}"}], ",", 
