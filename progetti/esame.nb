 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"rankFinalSubkeyNibble", "[", 
     RowBox[{
     "pairs_List", ",", "plaintextMask_Integer", ",", 
      "finalInputMask_Integer"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "info", ",", "position", ",", "nibbleMask", ",", "n", ",", "scores", ",",
         "countZero", ",", "bias"}], "}"}], ",", 
      RowBox[{
       RowBox[{"info", "=", 
        RowBox[{"singleActiveNibbleInfo", "[", "finalInputMask", "]"}]}], ";",
        "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"MissingQ", "[", "info", "]"}], ",", 
         RowBox[{"Return", "[", "info", "]"}]}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"position", "=", 
        RowBox[{"info", "[", "\"\<position\>\"", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"nibbleMask", "=", 
        RowBox[{"info", "[", "\"\<mask\>\"", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"n", "=", 
        RowBox[{"Length", "[", "pairs", "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"scores", "=", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"countZero", "=", 
            RowBox[{"Count", "[", 
             RowBox[{"pairs", ",", 
              RowBox[{"pair_", "/;", 
               RowBox[{"Module", "[", 
                RowBox[{
                 RowBox[{"{", 
                  RowBox[{"value", ",", "linearValue"}], "}"}], ",", 
                 RowBox[{
                  RowBox[{"value", "=", 
                   RowBox[{"sboxInv", "[", 
                    RowBox[{"[", 
                    RowBox[{
                    RowBox[{"BitXor", "[", 
                    RowBox[{
                    RowBox[{"getNibble", "[", 
                    RowBox[{
                    RowBox[{"pLayerInv", "[", 
                    RowBox[{"pair", "[", 
                    RowBox[{"[", "2", "]"}], "]"}], "]"}], ",", "position"}], 
                    "]"}], ",", "keyGuess"}], "]"}], "+", "1"}], "]"}], 
                    "]"}]}], ";", "\[IndentingNewLine]", 
                  RowBox[{"linearValue", "=", 
                   RowBox[{"BitXor", "[", 
                    RowBox[{
                    RowBox[{"parityBit", "[", 
                    RowBox[{"BitAnd", "[", 
                    RowBox[{"plaintextMask", ",", 
                    RowBox[{"pair", "[", 
                    RowBox[{"[", "1", "]"}], "]"}]}], "]"}], "]"}], ",", 
                    RowBox[{"parityBit", "[", 
                    RowBox[{"BitAnd", "[", 
                    RowBox[{"nibbleMask", ",", "value"}], "]"}], "]"}]}], 
                    "]"}]}], ";", "\[IndentingNewLine]", 
                  RowBox[{"linearValue", "==", "0"}]}]}], "]"}]}]}], "]"}]}], 
           ";", "\[IndentingNewLine]", 
           RowBox[{"bias", "=", 
            RowBox[{"countZero", "-", 
             RowBox[{"n", "/", "2"}]}]}], ";", "\[IndentingNewLine]", 
           RowBox[{"<|", 
            RowBox[{
             RowBox[{"\"\<guess\>\"", "->", "keyGuess"}], ",", 
             RowBox[{"\"\<countZero\>\"", "->", "countZero"}], ",", 
             RowBox[{"\"\<signedBias\>\"", "->", "bias"}], ",", 
             RowBox[{"\"\<absoluteBias\>\"", "->", 
              RowBox[{"Abs", "[", "bias", "]"}]}], ",", 
             RowBox[{"\"\<empiricalCorrelation\>\"", "->", 
              RowBox[{"N", "[", 
               RowBox[{"2", " ", 
                RowBox[{"bias", "/", "n"}]}], "]"}]}]}], "|>"}]}], ",", 
          RowBox[{"{", 
           RowBox[{"keyGuess", ",", "0", ",", "15"}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"SortBy", "[", 
        RowBox[{"scores", ",", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"-", 
             RowBox[{"#", "[", "\"\<absoluteBias\>\"", "]"}]}], ",", 
            RowBox[{"-", 
             RowBox[{"Abs", "[", 
              RowBox[{"#", "[", "\"\<empiricalCorrelation\>\"", "]"}], 
              "]"}]}], ",", 
            RowBox[{"#", "[", "\"\<guess\>\"", "]"}]}], "}"}], "&"}]}], 
        "]"}]}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
